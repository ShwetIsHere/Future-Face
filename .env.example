# ============================================================
# FutureFace Environment Configuration
# ============================================================
# Note: Keep this file private on production server. Never commit your actual .env to GitHub.

# Groq Cloud API Key (from https://console.groq.com/keys - starts with gsk_...)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Web3Forms Access Key for receiving email notifications (Keep private in .env, do NOT commit to Git!)
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
